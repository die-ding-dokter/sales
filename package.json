{
  "name": "die-ding-dokter-sales",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "api"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/configure-public.mjs && npm run build --workspace api",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:ui": "playwright test",
    "check": "npm run test && npm run build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  },
  "engines": {
    "node": ">=22"
  }
}
